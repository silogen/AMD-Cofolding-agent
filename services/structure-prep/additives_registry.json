  "heuristic_complement": {
    "description": "When a HETATM comp_id is NOT in this registry, apply these heuristics to classify it",
    "rules": [
      {
        "id": "high_multiplicity_additive",
        "condition": "HETATM group has >= 4 instances distributed across >= 3 chains in the asymmetric unit",
        "classification": "probable_additive",
        "action": "flag_for_agent_review",
        "notes": "Crystallographic multiplicity > 3 chains strongly suggests a buffer or cryoprotectant, not a specific binder"
      },
      {
        "id": "low_mw_buffer",
        "condition": "CCD type = NON-POLYMER AND formula_weight < 100 Da AND not a known cofactor fragment",
        "classification": "probable_buffer",
        "action": "flag_for_agent_review"
      },
      {
        "id": "single_chain_near_protein_candidate_ligand",
        "condition": "HETATM group has exactly 1 instance AND within 5 A of protein heavy atoms AND formula_weight > 150 Da",
        "classification": "likely_ligand",
        "action": "promote_to_ligand_review"
      },
      {
        "id": "single_atom_metal",
        "condition": "HETATM residue has exactly 1 atom AND element is a known metal (ZN, MG, CA, FE, MN, NI, CU, CO, MO, W, V, CR)",
        "classification": "metal",
        "action": "classify_as_metal",
        "notes": "Handled by Stage 2 metal classification before additive registry lookup"
      }
    ]
  },

