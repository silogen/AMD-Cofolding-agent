# Copy to services/env.local.sh. The real file is gitignored.
#
# Every assignment uses ${VAR:-default}: an already-exported value always wins.
# This prevents a stale local value from silently overriding the launch
# environment.

export LLM_GATEWAY_KEY="${LLM_GATEWAY_KEY:-REPLACE_ME}"
export REINVENT4_AGENT_API_KEY="${REINVENT4_AGENT_API_KEY:-}"
export REINVENT4_AGENT_BACKEND="${REINVENT4_AGENT_BACKEND:-anthropic}"
export REINVENT4_AGENT_MODEL="${REINVENT4_AGENT_MODEL:-claude-sonnet-4.6}"
export REINVENT4_AGENT_BASE_URL="${REINVENT4_AGENT_BASE_URL:-https://llm-gateway.example.com/Anthropic}"
export REINVENT4_AGENT_NO_VERIFY_SSL="${REINVENT4_AGENT_NO_VERIFY_SSL:-true}"
export REINVENT4_AGENT_THINKING_BUDGET="${REINVENT4_AGENT_THINKING_BUDGET:-1024}"
export REINVENT4_AGENT_MULTI_AGENT="${REINVENT4_AGENT_MULTI_AGENT:-false}"

# Load project paths, token limits, GPU assignment, and Slurm defaults.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env.sh"
